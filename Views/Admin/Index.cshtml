@model CompareD.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "לוח בקרה - ניהול המערכת";
}

@* =====================================================================
   כותרת ראשית של לוח הניהול - ללא Codename, ללא גרסה בראש הדף
   (הגרסה מוצגת ב-Footer בלבד - Feature 1)
   ===================================================================== *@
<div class="text-center mb-5" id="admin-dashboard-header">
    <h1 class="display-4 text-gradient mb-2" id="admin-main-title">🛡️ לוח בקרה ניהולי</h1>
    <p class="text-secondary fs-6" id="admin-subtitle">ניהול, ניטור ובקרה של מערכת CompareD</p>
</div>

@* =====================================================================
   כרטיסי Analytics מהירים - Feature 5 + 7
   הנתונים נקראים ב-REAL-TIME מהלוגים האמיתיים
   ===================================================================== *@
<div class="row g-4 mb-5" id="analytics-cards-row">
    @* כרטיס אחוז הצלחה - מחושב מ-AuditLogStore האמיתי *@
    <div class="col-12 col-md-3">
        <div class="glass-card p-4 text-center h-100 analytics-stat-card" id="success-rate-card">
            <div class="stat-icon mb-2">📊</div>
            <div class="stat-value @(Model.TotalActions == 0 ? "text-secondary" : "text-success")" id="success-rate-value">
                @(Model.TotalActions == 0 ? "אין נתונים" : $"{Model.SuccessRate}%")
            </div>
            <div class="stat-label">אחוז הצלחה</div>
            <div class="stat-sub mt-1">
                @if (Model.TotalActions == 0)
                {
                    <span>אין פעולות מתועדות עדיין</span>
                }
                else
                {
                    <span>@Model.SuccessCount הצלחות / @Model.TotalActions סה"כ</span>
                }
            </div>
        </div>
    </div>

    @* כרטיס זמן עיבוד ממוצע - מחושב מ-HealthMonitor האמיתי *@
    <div class="col-12 col-md-3">
        <div class="glass-card p-4 text-center h-100 analytics-stat-card" id="health-card">
            <div class="stat-icon mb-2">⚡</div>
            <div class="stat-value @(Model.HealthSamplesCount == 0 ? "text-secondary" : "text-info-soft")" id="avg-processing-value">
                @(Model.HealthSamplesCount == 0 ? "אין נתונים" : $"{Model.AvgProcessingTimeMs}ms")
            </div>
            <div class="stat-label">זמן עיבוד ממוצע</div>
            <div class="stat-sub mt-1">
                @(Model.HealthSamplesCount == 0 ? "טרם בוצעה השוואה" : $"{Model.HealthSamplesCount} דגימות נרשמו")
            </div>
        </div>
    </div>

    @* כרטיס משתמשים פעילים - מחושב מ-AuditLogStore האמיתי *@
    <div class="col-12 col-md-3">
        <div class="glass-card p-4 text-center h-100 analytics-stat-card" id="active-users-card">
            <div class="stat-icon mb-2">👥</div>
            <div class="stat-value text-warning-soft" id="active-users-value">@Model.RecentActiveUsers.Count</div>
            <div class="stat-label">משתמשים פעילים</div>
            <div class="stat-sub mt-1">ייחודיים בלוג</div>
        </div>
    </div>

    @* כרטיס כמות משתמשים רשומים *@
    <div class="col-12 col-md-3">
        <div class="glass-card p-4 text-center h-100 analytics-stat-card" id="total-users-card">
            <div class="stat-icon mb-2">🗄️</div>
            <div class="stat-value text-primary-soft" id="total-users-value">@Model.Users.Count</div>
            <div class="stat-label">סה"כ משתמשים</div>
            <div class="stat-sub mt-1">
                @Model.Users.Count(u => !u.IsBlocked) פעילים ·
                <span class="text-danger-soft">@Model.Users.Count(u => u.IsBlocked) חסומים</span>
            </div>
        </div>
    </div>
</div>

@* =====================================================================
   ניווט Tabs
   ===================================================================== *@
<ul class="nav nav-tabs mb-4" id="admin-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-users-btn" data-bs-toggle="tab" data-bs-target="#tab-users" type="button">
            👤 ניהול משתמשים
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-audit-btn" data-bs-toggle="tab" data-bs-target="#tab-audit" type="button">
            📋 Audit Log
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-syslogs-btn" data-bs-toggle="tab" data-bs-target="#tab-syslogs" type="button">
            🔴 System Logs
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-health-btn" data-bs-toggle="tab" data-bs-target="#tab-health" type="button">
            💚 System Health
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-settings-btn" data-bs-toggle="tab" data-bs-target="#tab-settings" type="button">
            ⚙️ הגדרות מערכת
        </button>
    </li>
</ul>

<div class="tab-content" id="admin-tab-content">

    @* ========================= TAB 1: ניהול משתמשים ========================= *@
    <div class="tab-pane fade show active" id="tab-users" role="tabpanel">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="admin-section-title mb-0">ניהול משתמשים</h4>
            <button class="btn btn-primary btn-glow px-4" data-bs-toggle="modal" data-bs-target="#addUserModal">
                + הוספת משתמש
            </button>
        </div>

        <div class="glass-card mb-4 p-4" id="search-card">
            <div class="row align-items-center gap-3 gap-md-0">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text admin-input-addon">🔍</span>
                        <input type="text" class="form-control admin-input" id="user-search-input" placeholder="חיפוש אנשים..." />
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <span class="admin-text-muted small"><strong class="admin-text-strong" id="total-users-count">@Model.Users.Count</strong> משתמשים במערכת</span>
                </div>
            </div>
        </div>

        <div class="glass-card p-0 overflow-hidden" id="users-table-card">
            <div class="table-responsive">
                <table class="table admin-table mb-0" id="users-management-table">
                    <thead>
                        <tr>
                            <th style="width:25%">משתמש</th>
                            <th style="width:20%">אימייל</th>
                            <th style="width:15%">סוג הזדהות</th>
                            <th style="width:15%">כניסה אחרונה</th>
                            <th style="width:15%" class="text-center">סטטוס</th>
                            <th style="width:10%" class="text-center">הרשאה</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users.OrderByDescending(u => u.CreatedAt))
                        {
                            var initial = !string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : (!string.IsNullOrEmpty(user.Username) ? user.Username.Substring(0, 1).ToUpper() : "?");
                            var displayName = !string.IsNullOrEmpty(user.FullName) ? user.FullName : user.Username;

                            <tr class="user-row align-middle" data-username="@user.Username">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-avatar-circle">@initial</div>
                                        <div>
                                            <div class="admin-text-strong fw-bold">@displayName</div>
                                            <div class="admin-text-muted font-monospace small">@user.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="admin-text-muted small">@(string.IsNullOrEmpty(user.Email) ? "—" : user.Email)</td>
                                <td>
                                    <span class="auth-type-badge">
                                        <span class="auth-type-icon">@(user.AuthType == "Active Directory" ? "💻" : "👤")</span>
                                        @user.AuthType
                                    </span>
                                </td>
                                <td class="admin-text-muted font-monospace small">@(user.LastLogin > DateTime.MinValue ? user.LastLogin.ToString("yyyy-MM-dd") : "—")</td>
                                <td class="text-center user-status-badge-cell">
                                    @if (user.IsBlocked)
                                    {
                                        <span class="admin-badge admin-badge-danger user-status-badge">חסום</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-success user-status-badge">מאושר</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input user-auth-toggle" type="checkbox" role="switch"
                                               data-username="@user.Username"
                                               @(user.IsBlocked ? "" : "checked")
                                               style="width:2.6rem;height:1.3rem;cursor:pointer;" />
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Users.Any())
                        {
                            <tr><td colspan="4" class="text-center admin-text-muted py-4">אין משתמשים רשומים במערכת.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ========================= TAB 2: Audit Log ========================= *@
    <div class="tab-pane fade" id="tab-audit" role="tabpanel">

        @* ===== פסק דין: מה דורש תשומת לב, לפני כל מספר ===== *@
        @* הלוח פתח בארבעה מספרים והמנהל נדרש להסיק מהם בעצמו מה בוער. *@
        @if (!string.IsNullOrEmpty(Model.Verdict.Headline))
        {
                string verdictClass = Model.Verdict.Status switch
                {
                    "Ok" => "dash-verdict-ok",
                    "Critical" => "dash-verdict-critical",
                    _ => "dash-verdict-warning"
                };
            <div class="dash-verdict @verdictClass mb-4" id="dashboard-verdict-card">
                <span class="dash-verdict-dot"></span>
                <div>
                    <h2 class="dash-verdict-headline">@Model.Verdict.Headline</h2>
                    <p class="dash-verdict-detail">@Model.Verdict.Detail</p>
                </div>
            </div>
        }

        @* ===== גרף 14 הימים: שבועיים במבט אחד ===== *@
        @if (Model.DailyActivity.Count > 0)
        {
                // סקאלה אחת לכל העמודות, אחרת ההשוואה בין ימים אינה אמיתית
                int dailyPeak = Model.DailyActivity.Max(d => d.Total);
                if (dailyPeak < 1) { dailyPeak = 1; }

                // הגובה נכתב תמיד בנקודה עשרונית ולא בפסיק.
                // ב-CSS רק הנקודה תקפה, ולכן על שרת שהתרבות שלו משתמשת בפסיק
                // כל העמודות היו הופכות ל-height:66,7% ומתקפלות לאפס.
                Func<int, string> dayPct = v =>
                    Math.Round((double)v / dailyPeak * 100, 1)
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
            <div class="glass-card mb-4 p-4" id="daily-activity-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="admin-section-title mb-0">📈 פעילות ב-14 הימים האחרונים</h5>
                    <span class="admin-text-muted small">גובה = פעולות · אדום = כשלים</span>
                </div>
                <div class="dash-days">
                    @foreach (var day in Model.DailyActivity)
                    {
                        @* role ו-aria-label ולא title בלבד: title אינו נגיש
                           במקלדת ואינו קיים כלל במגע, ולכן הנתון של כל יום
                           היה בלתי מושג לכל מי שאינו מרחף עם עכבר. *@
                        @* data-ux-drill-day הופך את העמודה ללחיצה שפותחת את
                           הרשומות של אותו יום. גרף בלי פירוט הוא מספר שאין
                           מה לעשות איתו - כאן לוחצים ורואים מי, מה ומתי. *@
                        <div class="dash-day" role="img"
                             data-ux-drill-day="@day.Date.ToString("yyyy-MM-dd")"
                             data-ux-drill-label="@day.Date.ToString("dd.MM.yyyy")"
                             title="@day.Label — @day.Successes הצליחו, @day.Failures נכשלו (לחיצה לפירוט)"
                             aria-label="@day.Label: @day.Successes הצליחו, @day.Failures נכשלו">
                            @if (day.Total == 0)
                            {
                                <span class="dash-day-empty"></span>
                            }
                            else
                            {
                                @* ההצלחות נכתבות ראשונות ולכן יושבות למעלה,
                                   והכשלים האדומים בתחתית - כפי שכתוב בכיתוב
                                   הכרטיס וכפי שהעיגול הפינות ב-CSS מצפה. *@
                                @if (day.Successes > 0)
                                {
                                    <span class="dash-day-ok" style="height:@(dayPct(day.Successes))%"></span>
                                }
                                @if (day.Failures > 0)
                                {
                                    <span class="dash-day-bad" style="height:@(dayPct(day.Failures))%"></span>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="dash-days-axis">
                    <span class="font-monospace">@Model.DailyActivity.First().Label</span>
                    <span class="font-monospace">@Model.DailyActivity.Last().Label</span>
                </div>
                <div class="d-flex gap-4 mt-3">
                    @* דלתא מוצגת רק כשיש שבוע קודם להשוות אליו. בלי התנאי, *@
                    @* בשבוע הראשון של השימוש הוצג "+91.7 נקודות" - מה שנקרא *@
                    @* כשיפור דרמטי, כשבפועל לא היה עם מה להשוות. *@
                    <span class="admin-text-muted small">
                        השבוע: <strong class="admin-text-strong">@Model.Trend.RunsThisWeek</strong> השוואות
                        @if (Model.Trend.HasPreviousWeek && Model.Trend.RunsDelta != 0)
                        {
                            <span class="@(Model.Trend.RunsDelta > 0 ? "admin-text-success" : "admin-text-warning")">
                                (@(Model.Trend.RunsDelta > 0 ? "+" : "")@Model.Trend.RunsDelta מהשבוע שעבר)
                            </span>
                        }
                    </span>
                    <span class="admin-text-muted small">
                        אחוז הצלחה: <strong class="admin-text-strong">@Model.Trend.RateThisWeek%</strong>
                        @if (Model.Trend.HasPreviousWeek && Model.Trend.RateDelta != 0)
                        {
                            <span class="@(Model.Trend.RateDelta > 0 ? "admin-text-success" : "admin-text-warning")">
                                (@(Model.Trend.RateDelta > 0 ? "+" : "")@Model.Trend.RateDelta נקודות)
                            </span>
                        }
                        else if (!Model.Trend.HasPreviousWeek)
                        {
                            <span class="admin-text-muted">(אין שבוע קודם להשוואה)</span>
                        }
                    </span>
                </div>
            </div>
        }

        @* =============================================================== *@
        @* ===== מפת חום שנתית: האם השימוש נמשך או התרכז בשבוע אחד ===== *@
        @* גרף 14 הימים עונה על "מה קרה השבועיים האחרונים". זה עונה על    *@
        @* שאלה אחרת, ותופס פחות מקום מ-182 עמודות.                       *@
        @* =============================================================== *@
        @if (Model.YearActivity.Count > 0)
        {
                // עוצמת הצבע נקבעת מול השיא, כדי שהסקאלה תהיה יחסית
                // לנפח השימוש האמיתי ולא למספר קבוע שנבחר מראש.
                int heatPeak = Model.YearActivity.Max(d => d.Total);
                if (heatPeak < 1) { heatPeak = 1; }

                Func<int, string> heatClass = total =>
                {
                    if (total == 0) return string.Empty;
                    double share = (double)total / heatPeak;
                    if (share <= 0.25) return "ux-heat-1";
                    if (share <= 0.50) return "ux-heat-2";
                    if (share <= 0.75) return "ux-heat-3";
                    return "ux-heat-4";
                };

                int activeDays = Model.YearActivity.Count(d => d.Total > 0);
            <div class="glass-card mb-4 p-4" id="year-heatmap-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="admin-section-title mb-0">🗓️ מפת פעילות — 26 השבועות האחרונים</h5>
                    <span class="admin-text-muted small">
                        <strong class="admin-text-strong ux-countup">@activeDays</strong>
                        ימי פעילות · לחיצה על יום פותחת את הרשומות
                    </span>
                </div>

                <div class="ux-heatmap" id="year-heatmap-grid">
                    @foreach (var day in Model.YearActivity)
                    {
                        @* יום עם כשלים מקבל מסגרת אדומה ולא רק גוון אחר,
                           כדי שהצבע לא יהיה הנשא היחיד של המשמעות. *@
                        <div class="ux-heat-cell @heatClass(day.Total) @(day.Failures > 0 ? "ux-heat-bad" : "")"
                             data-count="@day.Total"
                             @* התכונה נכתבת רק ליום שיש בו רשומות. ערך null
                                גורם ל-Razor להשמיט את התכונה כולה, ולכן יום
                                ריק אינו נראה לחיץ ואינו פותח חלון ריק. *@
                             data-ux-drill-day="@(day.Total > 0 ? day.Date.ToString("yyyy-MM-dd") : null)"
                             data-ux-drill-label="@day.Label"
                             title="@day.Label — @day.Successes הצליחו, @day.Failures נכשלו"></div>
                    }
                </div>

                <div class="ux-heat-legend">
                    <span>פחות</span>
                    <i style="background: var(--border-color);"></i>
                    <i class="ux-heat-1"></i>
                    <i class="ux-heat-2"></i>
                    <i class="ux-heat-3"></i>
                    <i class="ux-heat-4"></i>
                    <span>יותר</span>
                    <span class="ms-3">
                        <i class="ux-heat-bad" style="background: var(--border-color);"></i>
                        מסגרת אדומה = היו כשלים באותו יום
                    </span>
                </div>
            </div>
        }

        @* =============================================================== *@
        @* ===== משפך השלבים: איפה העובדים נושרים ===== *@
        @* אחוז ההצלחה אומר כמה פעולות הצליחו, לא כמה עובדים הגיעו עד    *@
        @* הדוח. עובד שמיפה ואז נטש אינו נספר כאף כשל, ובכל זאת הוא      *@
        @* בדיוק המקרה שצריך לטפל בו.                                     *@
        @* =============================================================== *@
        @if (Model.Funnel.Count > 0 && Model.Funnel[0].Users > 0)
        {
                double funnelBase = Model.Funnel[0].Users;
                if (funnelBase < 1) { funnelBase = 1; }

                // הרוחב לא יורד מתחת ל-8% כדי ששלב עם עובד אחד יישאר
                // נראה ולחיץ, ולא ייעלם לפס בעובי אפס.
                Func<int, string> funnelWidth = users =>
                    Math.Max(8, Math.Round(users / funnelBase * 100, 1))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
            <div class="glass-card mb-4 p-4" id="funnel-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="admin-section-title mb-0">🔻 איפה העובדים נושרים</h5>
                    <span class="admin-text-muted small">
                        עובדים ייחודיים שהשלב הצליח להם · לחיצה על שלב פותחת את הרשומות
                    </span>
                </div>

                <div class="ux-funnel" id="funnel-stages">
                    @for (int i = 0; i < Model.Funnel.Count; i++)
                    {
                        var stage = Model.Funnel[i];
                        <div class="ux-funnel-row">
                            <div class="ux-funnel-label">
                                @stage.Title
                                <small>@stage.Detail</small>
                            </div>
                            <div class="ux-funnel-track">
                                <div class="ux-funnel-bar @(stage.Users == 0 ? "ux-funnel-empty" : "")"
                                     style="width: @funnelWidth(stage.Users)%"
                                     data-ux-drill-actions="@string.Join(",", stage.Actions)"
                                     data-ux-drill-label="@stage.Title"
                                     title="@stage.Users עובדים, @stage.Runs פעולות מוצלחות, @stage.Failures כשלים">
                                    @stage.Users
                                </div>
                            </div>
                            <div class="ux-funnel-side">
                                @stage.ReachPercentage% מהעובדים
                                @if (stage.Failures > 0)
                                {
                                    <span class="admin-text-warning d-block">
                                        @stage.Failures כשלים
                                    </span>
                                }
                            </div>
                        </div>

                        @* הנשירה כתובה בין השלבים במספרים, כי זה מה שצריך
                           לפעול לפיו - לא ההפרש בין שני רוחבי פסים. *@
                        @if (i < Model.Funnel.Count - 1)
                        {
                            var next = Model.Funnel[i + 1];
                            int drop = stage.Users - next.Users;
                            <div class="ux-funnel-drop @(drop <= 0 ? "ux-funnel-nodrop" : "")">
                                @if (drop > 0)
                                {
                                    <span>↓ @drop @(drop == 1 ? "עובד לא המשיך" : "עובדים לא המשיכו") מכאן</span>
                                }
                                else
                                {
                                    <span>↓ כל מי שהגיע לשלב הזה המשיך</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @* ===== פירוט לפי משתמש ===== *@
        @* אחוז ההצלחה הגלובלי אינו מבדיל בין עובד שמריץ בהצלחה לעובד שנתקע *@
        @* שוב ושוב באותו שלב. הפירוט הזה מראה למי צריך הדרכה, ובמה. *@
        @if (Model.PerUserStats.Count > 0)
        {
            <div class="glass-card mb-4 p-4" id="per-user-stats-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="admin-section-title mb-0">👤 פעילות לפי עובד</h5>
                    <span class="admin-text-muted small">@Model.PerUserStats.Count עובדים</span>
                </div>
                <div class="table-responsive">
                    <table class="table admin-table align-middle" id="per-user-stats-table"
                           data-ux-sort data-ux-filter="סינון עובדים: שם, שלב שנכשל" data-ux-copy-table>
                        <thead>
                            <tr>
                                @* "השוואות" הוא תת-קבוצה של הפעולות: העלאת קבצים והתחברות *@
                                @* למסד נחשבות פעולות אך אינן השוואות. הכותרות מבדילות ביניהן *@
                                @* במפורש, כדי שלא ייראה כאילו המספרים אינם מסתדרים. *@
                                <th style="width:22%">עובד</th>
                                <th style="width:10%" class="text-center">השוואות שהריץ</th>
                                <th style="width:10%" class="text-center">פעולות שהצליחו</th>
                                <th style="width:10%" class="text-center">פעולות שנכשלו</th>
                                <th style="width:12%" class="text-center">אחוז הצלחה</th>
                                <th style="width:16%">פעיל לאחרונה</th>
                                <th style="width:20%">נתקע הכי הרבה ב-</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in Model.PerUserStats)
                                {
                                    // פס חומרה בקצה השורה: המצב נקרא בסריקה ולא בקריאה
                                    string stripe = stat.SuccessRate >= 90 ? "dash-stripe-ok"
                                        : stat.SuccessRate >= 70 ? "dash-stripe-warn" : "dash-stripe-bad";
                                    string rateColor = stat.SuccessRate >= 90 ? "var(--color-success)"
                                        : stat.SuccessRate >= 70 ? "var(--color-warning)" : "var(--color-danger)";
                                <tr class="@stripe" data-ux-drill-user="@stat.Username"
                                    title="לחיצה על השורה פותחת את כל הפעולות של העובד">
                                    <td class="admin-text-strong font-monospace small">@stat.Username</td>
                                    <td class="text-center admin-text-strong">@stat.ComparisonRuns</td>
                                    <td class="text-center admin-text-success">@stat.SuccessfulActions</td>
                                    <td class="text-center @(stat.FailedActions > 0 ? "admin-text-warning" : "admin-text-muted")">@stat.FailedActions</td>
                                    <td class="text-center">
                                        <span class="admin-badge @(stat.SuccessRate >= 90 ? "admin-badge-success" : stat.SuccessRate >= 70 ? "admin-badge-warning" : "admin-badge-danger")">
                                            @stat.SuccessRate%
                                        </span>
                                        @* אחוז ההצלחה גם כפס: אורך נקרא מיד, מספר דורש השוואה בראש *@
                                        <span class="dash-rate-track d-block mt-2">
                                            <span class="dash-rate-fill" style="width:@stat.SuccessRate%;background:@rateColor"></span>
                                        </span>
                                    </td>
                                    <td class="admin-text-muted font-monospace small">@stat.LastActivity.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="admin-text-muted small">
                                        @if (stat.MostFrequentFailureCount > 0)
                                        {
                                            @CompareD.Models.AuditActionTranslator.Translate(stat.MostFrequentFailure)
                                            <span class="admin-text-warning">(@stat.MostFrequentFailureCount)</span>
                                        }
                                        else
                                        {
                                            <span class="admin-text-success">ללא כשלים</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ===== מצב תקין נראה תקין, במקום טבלה ריקה שנראית כמו תקלה ===== *@
        @if (Model.FailureBreakdown.Count == 0 && Model.PerUserStats.Count > 0)
        {
            <div class="glass-card mb-4 p-4" id="no-failures-card">
                <div class="dash-allclear">
                    <div class="dash-allclear-big">✓ לא נרשם אף כשל</div>
                    <p>כל הפעולות שנרשמו במערכת הסתיימו בהצלחה. אין שלב שעובדים נתקעים בו.</p>
                </div>
            </div>
        }

        @* ===== איפה נופלים ===== *@
        @* שלב שנכשל אצל משתמש אחד הוא תקלה נקודתית; שלב שנכשל אצל כמה *@
        @* משתמשים הוא בעיה במערכת או בהדרכה - ולכן מוצג מספר המשתמשים השונים. *@
        @if (Model.FailureBreakdown.Count > 0)
        {
            <div class="glass-card mb-4 p-4" id="failure-breakdown-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="admin-section-title mb-0">⚠ איפה עובדים נופלים</h5>
                    <span class="admin-text-muted small">מהשכיח לנדיר</span>
                </div>
                @* ===== התפלגות כשלים כפסים, מעל הטבלה ולא במקומה ===== *@
                @* הרוחב אומר כמה, והשורה מתחת אומרת אצל כמה עובדים. הטבלה *@
                @* שמתחת נשארת כי היא נושאת מידע שהפסים אינם מראים - *@
                @* מתי זה קרה לאחרונה ומה היה הפירוט. *@
                @{
                    int failurePeak = Model.FailureBreakdown.Max(f => f.Count);
                    if (failurePeak < 1) { failurePeak = 1; }
                }
                <div class="mb-4" id="failure-breakdown-bars">
                    @foreach (var failure in Model.FailureBreakdown.Take(6))
                    {
                        <div class="dash-bar" data-ux-drill-actions="@failure.Action"
                             data-ux-drill-label="@failure.HebrewAction"
                             title="לחיצה פותחת את כל הכשלים בשלב הזה">
                            <div class="dash-bar-head">
                                <span>@failure.HebrewAction</span>
                                <span class="dash-bar-count font-monospace">@failure.Count</span>
                            </div>
                            <div class="dash-bar-track">
                                <span class="dash-bar-fill"
                                      style="width:@(Math.Round((double)failure.Count / failurePeak * 100, 1))%;background:@(failure.DistinctUsers > 1 ? "var(--color-danger)" : "var(--color-warning)")"></span>
                            </div>
                            <div class="dash-bar-note">
                                @if (failure.DistinctUsers > 1)
                                {
                                    <span class="dash-bar-shared">@failure.DistinctUsers עובדים</span>
                                    <span> — לא תקלה נקודתית</span>
                                }
                                else
                                {
                                    <span>עובד אחד</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table admin-table align-middle" id="failure-breakdown-table"
                           data-ux-sort data-ux-copy-table>
                        <thead>
                            <tr>
                                <th style="width:30%">השלב</th>
                                <th style="width:10%" class="text-center">כשלים</th>
                                <th style="width:14%" class="text-center">עובדים שונים</th>
                                <th style="width:16%">בפעם האחרונה</th>
                                <th style="width:30%">פירוט אחרון</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var failure in Model.FailureBreakdown)
                            {
                                <tr data-ux-drill-actions="@failure.Action"
                                    data-ux-drill-label="@failure.HebrewAction"
                                    title="לחיצה על השורה פותחת את הרשומות">
                                    <td class="admin-text-strong small">@failure.HebrewAction</td>
                                    <td class="text-center admin-text-warning">@failure.Count</td>
                                    <td class="text-center">
                                        <span class="admin-badge @(failure.DistinctUsers > 1 ? "admin-badge-danger" : "admin-badge-warning")">
                                            @failure.DistinctUsers
                                        </span>
                                    </td>
                                    <td class="admin-text-muted font-monospace small">@failure.LastOccurrence.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="admin-text-muted small" style="word-break: break-word;">@failure.LastDetails</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="admin-text-muted small mb-0 mt-3">
                    שלב שמופיע כאן עם <strong class="admin-text-danger">יותר מעובד אחד</strong> אינו תקלה נקודתית —
                    הוא סימן שהמערכת או ההדרכה לא ברורות באותו שלב.
                </p>
            </div>
        }


        <div class="glass-card mb-4 p-4" id="audit-search-card">
            <div class="row align-items-center gap-3 gap-md-0">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text admin-input-addon">🔍</span>
                        <input type="text" class="form-control admin-input" id="audit-search-input" placeholder="חיפוש לפי עובד או פעולה..." />
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <span class="admin-text-muted small">סה"כ רשומות המוצגות: <strong class="admin-text-strong" id="total-audit-count">...</strong></span>
                </div>
            </div>
        </div>

        <div class="glass-card p-4" id="audit-log-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="admin-section-title mb-0">📋 יומן פעולות משתמשים</h5>
                <span class="admin-text-muted small">עד 1,000 רשומות אחרונות</span>
            </div>
            <div class="d-flex gap-2 mb-4 flex-wrap">
                <button class="btn admin-filter-btn active" data-filter="all" id="audit-filter-all">הכל</button>
                <button class="btn admin-filter-btn" data-filter="Success" id="audit-filter-success">✅ הצלחות</button>
                <button class="btn admin-filter-btn" data-filter="Failed" id="audit-filter-failed">❌ כישלונות</button>
            </div>
            <div class="table-responsive">
                @{
                    var auditEntries = CompareD.Models.AuditLogStore.GetAll();
                }
                <table class="table admin-table" id="audit-log-table">
                    <thead>
                        <tr>
                            <th style="width:18%">תאריך ושעה</th>
                            <th style="width:22%">משתמש</th>
                            <th style="width:20%">פעולה</th>
                            <th style="width:28%">פרטים</th>
                            <th style="width:12%" class="text-center">סטטוס</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!auditEntries.Any())
                        {
                            <tr><td colspan="5" class="text-center admin-text-muted py-5">
                                <div class="mb-2" style="font-size:2rem;">📋</div>
                                אין רשומות Audit Log עדיין.<br/>
                                <small>הלוג יתמלא אוטומטית עם כל פעולה שתבוצע במערכת.</small>
                            </td></tr>
                        }
                        else
                        {
                            @foreach (var entry in auditEntries)
                            {
                                <tr class="audit-row" data-status="@entry.Status">
                                    <td class="admin-text-muted font-monospace small">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="admin-text-strong font-monospace small">@entry.Username</td>
                                    <td class="admin-text-accent small fw-semibold">@entry.Action</td>
                                    <td class="admin-text-muted small" title="@entry.Details">
                                        @(entry.Details.Length > 60 ? entry.Details.Substring(0, 60) + "..." : entry.Details)
                                    </td>
                                    <td class="text-center">
                                        @if (entry.Status == "Success")
                                        {
                                            <span class="admin-badge admin-badge-success">✅ הצלחה</span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-danger">❌ כישלון</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ========================= TAB 3: System Logs ========================= *@
    <div class="tab-pane fade" id="tab-syslogs" role="tabpanel">

        <div class="glass-card mb-4 p-4" id="syslog-search-card">
            <div class="row align-items-center gap-3 gap-md-0">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text admin-input-addon">🔍</span>
                        <input type="text" class="form-control admin-input" id="syslog-search-input" placeholder="חיפוש לפי שגיאה, קוד או נתיב..." />
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <span class="admin-text-muted small">סה"כ שגיאות המוצגות: <strong class="admin-text-strong" id="total-syslog-count">...</strong></span>
                </div>
            </div>
        </div>

        <div class="glass-card p-4" id="system-logs-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="admin-section-title mb-0">🔴 לוג שגיאות מערכת</h5>
                <span class="admin-text-muted small">תרגום אוטומטי לעברית · שגיאות אמיתיות בלבד</span>
            </div>
            <div class="table-responsive">
                @{
                    var systemLogs = CompareD.Models.SystemLogger.GetAll();
                }
                <table class="table admin-table" id="system-logs-table">
                    <thead>
                        <tr>
                            <th style="width:15%">תאריך</th>
                            <th style="width:8%" class="text-center">קוד</th>
                            <th style="width:20%">נתיב בקשה</th>
                            <th style="width:15%">משתמש</th>
                            <th style="width:42%">הסבר בעברית</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!systemLogs.Any())
                        {
                            <tr><td colspan="5" class="text-center admin-text-muted py-5">
                                <div class="mb-2" style="font-size:2rem;">🎉</div>
                                אין שגיאות מערכת רשומות! המערכת פועלת תקין.<br/>
                                <small>שגיאות HTTP 4xx/5xx יירשמו כאן אוטומטית.</small>
                            </td></tr>
                        }
                        else
                        {
                            @foreach (var log in systemLogs)
                            {
                                <tr class="syslog-row">
                                    <td class="admin-text-muted font-monospace small">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="text-center">
                                        <span class="admin-badge @(log.HttpStatusCode >= 500 ? "admin-badge-danger" : "admin-badge-warning")">
                                            @log.HttpStatusCode
                                        </span>
                                    </td>
                                    <td class="admin-text-muted font-monospace small">@log.RequestPath</td>
                                    <td class="admin-text-strong font-monospace small">@log.Username</td>
                                    <td class="admin-text-warning small">@log.HebrewExplanation</td>
                                </tr>
                                @* שורת המשך: תרגום ההודעה הטכנית לעברית, המלצת פעולה, *@
                                @* וההודעה המקורית באנגלית. עד כה ההודעה המקורית נשמרה *@
                                @* בקובץ הלוג אך לא הוצגה כאן בכלל, וקוד HTTP לבדו אינו *@
                                @* מסביר תקלה - 500 יכול להיות סיסמה שגויה או קובץ נעול. *@
                                @if (!string.IsNullOrWhiteSpace(log.HebrewErrorMessage)
                                    || !string.IsNullOrWhiteSpace(log.ErrorMessage))
                                {
                                    <tr class="syslog-row">
                                        <td colspan="5" class="pt-0">
                                            @if (!string.IsNullOrWhiteSpace(log.HebrewErrorMessage))
                                            {
                                                <div class="admin-text-strong small mb-1">
                                                    <span class="admin-badge admin-badge-danger">מה קרה</span>
                                                    <span class="ms-2">@log.HebrewErrorMessage</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(log.SuggestedAction))
                                            {
                                                <div class="admin-text-warning small mb-1">
                                                    <span class="admin-badge admin-badge-warning">מה לעשות</span>
                                                    <span class="ms-2">@log.SuggestedAction</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                                            {
                                                <div class="admin-text-muted font-monospace" style="font-size: 0.75rem; word-break: break-word;">
                                                    ההודעה המקורית: @log.ErrorMessage
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ========================= TAB 4: System Health ========================= *@
    <div class="tab-pane fade" id="tab-health" role="tabpanel">
        <div class="row g-4" id="health-monitor-section">
            <div class="col-12 col-lg-6">
                <div class="glass-card p-4 h-100" id="health-widget-card">
                    <h5 class="admin-section-title mb-4">💚 ניטור בריאות מערכת</h5>
                    @if (Model.HealthSamplesCount == 0)
                    {
                        <div class="text-center py-4 admin-text-muted">
                            <div class="mb-2" style="font-size:2rem;">⏳</div>
                            <p>אין דגימות עדיין.</p>
                            <small>זמן עיבוד ייתועד אוטומטית עם הרצת ההשוואה הראשונה.</small>
                        </div>
                    }
                    else
                    {
                        <div class="health-metric-row">
                            <span class="health-label">זמן עיבוד ממוצע:</span>
                            <span class="health-value @(Model.AvgProcessingTimeMs < 3000 ? "text-success" : Model.AvgProcessingTimeMs < 8000 ? "text-warning" : "text-danger")">
                                @Model.AvgProcessingTimeMs ms
                            </span>
                        </div>
                        <div class="health-metric-row">
                            <span class="health-label">מספר דגימות:</span>
                            <span class="health-value admin-text-strong">@Model.HealthSamplesCount</span>
                        </div>
                        <div class="health-metric-row">
                            <span class="health-label">סטטוס מערכת:</span>
                            <span class="health-value">
                                @if (Model.AvgProcessingTimeMs < 3000)
                                { <span class="admin-badge admin-badge-success">✅ תקין</span> }
                                else if (Model.AvgProcessingTimeMs < 8000)
                                { <span class="admin-badge admin-badge-warning">⚠️ עומס בינוני</span> }
                                else
                                { <span class="admin-badge admin-badge-danger">❌ עומס גבוה</span> }
                            </span>
                        </div>
                    }
                    <div class="health-metric-row">
                        <span class="health-label">אחוז הצלחה כולל:</span>
                        <span class="health-value @(Model.TotalActions == 0 ? "admin-text-muted" : Model.SuccessRate >= 80 ? "text-success" : "text-warning")">
                            @(Model.TotalActions == 0 ? "—" : $"{Model.SuccessRate}%")
                        </span>
                    </div>
                    <div class="health-metric-row">
                        <span class="health-label">סה"כ פעולות:</span>
                        <span class="health-value admin-text-strong">@(Model.TotalActions == 0 ? "אין עדיין" : Model.TotalActions.ToString())</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="glass-card p-4 h-100" id="recent-users-card">
                    <h5 class="admin-section-title mb-4">🕐 משתמשים פעילים לאחרונה</h5>
                    @if (!Model.RecentActiveUsers.Any())
                    {
                        <div class="text-center py-4 admin-text-muted">
                            <div class="mb-2" style="font-size:2rem;">👤</div>
                            <p>אין פעילות מתועדת עדיין.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var u in Model.RecentActiveUsers)
                            {
                                <li class="recent-user-item">
                                    <span class="user-avatar-dot">●</span>
                                    <span class="font-monospace admin-text-strong small">@u</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ========================= TAB 5: הגדרות מערכת ========================= *@
    <div class="tab-pane fade" id="tab-settings" role="tabpanel">
        <div class="glass-card p-4" id="system-settings-card">
            <h5 class="admin-section-title mb-2">⚙️ הגדרות מערכת דינמיות</h5>
            <p class="admin-text-muted small mb-4">שינויים אלו יחולו מיידית ללא הפעלה מחדש של השרת.</p>
            <form id="settings-form">
                @Html.AntiForgeryToken()
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="settings-label" for="max-file-upload-input">📦 גודל קובץ מקסימלי להעלאה (MB)</label>
                        <input type="number" id="max-file-upload-input" name="MaxFileUploadMb"
                               class="form-control admin-input mt-2"
                               value="@Model.Settings.MaxFileUploadMb" min="1" max="500" />
                        <small class="admin-text-muted">שים לב: לשינוי Kestrel/IIS יש לעדכן appsettings.json.</small>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="settings-label" for="system-alert-input">📢 הודעת מערכת (תוצג למשתמשים)</label>
                        <input type="text" id="system-alert-input" name="SystemAlertMessage"
                               class="form-control admin-input mt-2"
                               value="@Model.Settings.SystemAlertMessage"
                               placeholder="השאר ריק לביטול ההודעה" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="settings-label" for="admin-contact-input">👤 שם מנהל המערכת לתצוגה</label>
                        <input type="text" id="admin-contact-input" name="AdminContactName"
                               class="form-control admin-input mt-2"
                               value="@Model.Settings.AdminContactName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="settings-label" for="app-version-input">🔖 גרסת מערכת נוכחית (PWA / Footer)</label>
                        <input type="text" id="app-version-input" name="AppVersion"
                               class="form-control admin-input mt-2 font-monospace"
                               value="@Model.Settings.AppVersion"
                               placeholder="לדוגמה: 1.1.0" dir="ltr" />
                        <small class="admin-text-muted">שינוי הערך כאן יעדכן מידית את הגרסה המוצגת לכל המשתמשים.</small>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="settings-label d-block">🔧 הפעלת שירותים</label>
                        <div class="mt-2 d-flex flex-column gap-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="audit-logging-toggle"
                                       name="IsAuditLoggingEnabled" @(Model.Settings.IsAuditLoggingEnabled ? "checked" : "") />
                                <label class="form-check-label admin-text-muted" for="audit-logging-toggle">רישום Audit Log</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="error-logging-toggle"
                                       name="IsErrorLoggingEnabled" @(Model.Settings.IsErrorLoggingEnabled ? "checked" : "") />
                                <label class="form-check-label admin-text-muted" for="error-logging-toggle">רישום שגיאות מערכת</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="health-monitor-toggle"
                                       name="IsHealthMonitorEnabled" @(Model.Settings.IsHealthMonitorEnabled ? "checked" : "") />
                                <label class="form-check-label admin-text-muted" for="health-monitor-toggle">ניטור בריאות מערכת</label>
                            </div>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Settings.LastUpdatedBy))
                {
                    <div class="mt-4 admin-text-muted small">
                        עדכון אחרון: <strong class="admin-text-strong">@Model.Settings.LastUpdatedBy</strong>
                        ב-<strong class="admin-text-strong">@Model.Settings.LastUpdated.ToString("yyyy-MM-dd HH:mm")</strong>
                    </div>
                }
                <div class="mt-4">
                    <button type="button" class="btn btn-glow" id="save-settings-btn">💾 שמור הגדרות</button>
                    <span id="settings-save-feedback" class="ms-3 small"></span>
                </div>
            </form>
        </div>
    </div>

</div>

