                        <div class="mb-4">
                            <label class="settings-label mb-1">אימייל</label>
                            <input type="email" id="manual-email" class="form-control admin-input" placeholder="כתובת דואר אלקטרוני (אופציונלי)" dir="ltr" />
                        </div>
                        
                        <button type="button" class="btn btn-primary btn-glow w-100" id="btn-submit-manual-user">יצירת משתמש ידני</button>
                        <div id="add-manual-feedback" class="mt-2 text-center small"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    @* =================================================================== *@
    @* רשומות הביקורת שנשלחות לדפדפן עבור חלונות הפירוט בלחיצה.           *@
    @*                                                                     *@
    @* שמות השדות מקוצרים לאות אחת במכוון: הרשימה יכולה להגיע למאות        *@
    @* רשומות, ושם שדה מלא בכל אחת מהן היה מכפיל את גודל ה-JSON בדף.       *@
    @* הפעולה נשלחת גם באנגלית (a, לצורך הסינון) וגם בעברית (h, לתצוגה).  *@
    @* =================================================================== *@
    <script>
        window._auditDrill = {
            entries: [
                @for (int i = 0; i < Model.DrillEntries.Count; i++)
                {
                    var e = Model.DrillEntries[i];
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
                    {
                        t = e.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"),
                        u = e.Username,
                        a = e.Action,
                        h = CompareD.Models.AuditActionTranslator.Translate(e.Action),
                        s = e.Status,

                        // הפירוט נחתך ל-200 תווים בעומס הזה בלבד.
                        //
                        // JsonSerializer מקודד עברית כ-\uXXXX (וזה נכון:
                        // כך גם '<' מקודד, ולכן פירוט שמכיל תג לא יכול
                        // לשבור את בלוק ה-script). אבל כל תו עברי הופך
                        // לשישה בתים, ולכן 1000 רשומות עם פירוט ארוך היו
                        // מנפחות את הדף לכמעט מגה-בייט. הפירוט המלא מוצג
                        // בטאב "Audit Log" מהשרת.
                        d = e.Details != null && e.Details.Length > 200
                            ? e.Details.Substring(0, 200) + "…"
                            : e.Details
                    }))
                    @Html.Raw(i < Model.DrillEntries.Count - 1 ? "," : "")
                }
            ]
        };
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            // חיפוש משתמשים בזמן אמת
            const searchInput = document.getElementById("user-search-input");
            const userRows = document.querySelectorAll(".user-row");
            const totalCountSpan = document.getElementById("total-users-count");
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const query = searchInput.value.toLowerCase().trim();
                    let visible = 0;
                    userRows.forEach(row => {
                        const rowText = row.textContent.toLowerCase();
                        const show = rowText.includes(query);
                        row.classList.toggle("d-none", !show);
                        if (show) visible++;
                    });
                    if (totalCountSpan) totalCountSpan.textContent = visible;
                });
            }

            // Toggle חסימת משתמש
            document.querySelectorAll(".user-auth-toggle").forEach(toggle => {
                toggle.addEventListener("change", function () {
                    const username = toggle.getAttribute("data-username");
                    const isBlocked = !toggle.checked;
                    toggle.disabled = true;
                    const formData = new FormData();
                    formData.append("username", username);
                    formData.append("isBlocked", isBlocked);
                    fetch('@Url.Action("ToggleStatus", "Admin")', {
                        method: 'POST',
                        headers: { 'X-Csrf-Token': csrfToken },
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        toggle.disabled = false;
                        if (data.success) {
                            const row = toggle.closest("tr");
                            const badgeCell = row.querySelector(".user-status-badge-cell");
                            badgeCell.innerHTML = isBlocked
                                ? '<span class="admin-badge admin-badge-danger user-status-badge">חסום</span>'
                                : '<span class="admin-badge admin-badge-success user-status-badge">מאושר</span>';
                        } else {
                            toggle.checked = !isBlocked;
                            alert(data.message || "אירעה שגיאה.");
                        }
                    })
                    .catch(() => { toggle.disabled = false; toggle.checked = !isBlocked; alert("שגיאת תקשורת."); });
                });
            });

            // סינון Audit Log (כפתורי סטטוס + חיפוש טקסט חופשי)
            const auditSearchInput = document.getElementById("audit-search-input");
            const auditFilterBtns = document.querySelectorAll(".admin-filter-btn");
            const totalAuditCountSpan = document.getElementById("total-audit-count");
            let currentAuditFilter = "all";

            function filterAuditLog() {
                const query = auditSearchInput ? auditSearchInput.value.toLowerCase() : "";
                let visible = 0;
                document.querySelectorAll(".audit-row").forEach(row => {
                    const status = row.getAttribute("data-status");
                    const username = row.children[1].textContent.toLowerCase();
                    const action = row.children[2].textContent.toLowerCase();
                    
                    const matchesFilter = currentAuditFilter === "all" || status === currentAuditFilter;
                    const matchesSearch = username.includes(query) || action.includes(query);
                    
                    const isVisible = matchesFilter && matchesSearch;
                    row.classList.toggle("d-none", !isVisible);
                    if (isVisible) visible++;
                });
                if (totalAuditCountSpan) totalAuditCountSpan.textContent = visible;
            }

            // אתחול ספירה ראשונית
            filterAuditLog();

            auditFilterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    auditFilterBtns.forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    currentAuditFilter = btn.getAttribute("data-filter");
                    filterAuditLog();
                });
            });

            if (auditSearchInput) {
                auditSearchInput.addEventListener("input", filterAuditLog);
            }

            // סינון System Logs
            const syslogSearchInput = document.getElementById("syslog-search-input");
            const totalSyslogCountSpan = document.getElementById("total-syslog-count");

            function filterSysLog() {
                const query = syslogSearchInput ? syslogSearchInput.value.toLowerCase() : "";
                let visible = 0;
                document.querySelectorAll(".syslog-row").forEach(row => {
                    const code = row.children[1].textContent.toLowerCase();
                    const path = row.children[2].textContent.toLowerCase();
                    const error = row.children[4].textContent.toLowerCase();
                    
                    const isVisible = code.includes(query) || path.includes(query) || error.includes(query);
                    row.classList.toggle("d-none", !isVisible);
                    if (isVisible) visible++;
                });
                if (totalSyslogCountSpan) totalSyslogCountSpan.textContent = visible;
            }

            if (syslogSearchInput) {
                syslogSearchInput.addEventListener("input", filterSysLog);
                filterSysLog(); // אתחול
            }

            // שמירת הגדרות מערכת
            const saveBtn = document.getElementById("save-settings-btn");
            const feedback = document.getElementById("settings-save-feedback");
            if (saveBtn) {
                saveBtn.addEventListener("click", function () {
                    const formData = new FormData();
                    formData.append("MaxFileUploadMb", document.getElementById("max-file-upload-input").value);
                    formData.append("SystemAlertMessage", document.getElementById("system-alert-input").value);
                    formData.append("AdminContactName", document.getElementById("admin-contact-input").value);
                    formData.append("AppVersion", document.getElementById("app-version-input").value);
                    formData.append("IsAuditLoggingEnabled", document.getElementById("audit-logging-toggle").checked);
                    formData.append("IsErrorLoggingEnabled", document.getElementById("error-logging-toggle").checked);
                    formData.append("IsHealthMonitorEnabled", document.getElementById("health-monitor-toggle").checked);
                    const csrfInput = document.getElementById("settings-form").querySelector('input[name="__RequestVerificationToken"]');
                    if (csrfInput) formData.append("__RequestVerificationToken", csrfInput.value);

                    saveBtn.disabled = true;
                    if (feedback) { feedback.textContent = "שומר..."; feedback.className = "ms-3 small admin-text-muted"; }

                    fetch('@Url.Action("SaveSettings", "Admin")', {
                        method: 'POST',
                        headers: { 'X-Csrf-Token': csrfToken },
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        saveBtn.disabled = false;
                        feedback.textContent = data.success ? "✅ " + data.message : "❌ " + data.message;
                        feedback.className = "ms-3 small " + (data.success ? "text-success" : "text-danger");
                        setTimeout(() => { if (feedback) feedback.textContent = ""; }, 5000);
                    })
                    .catch(() => {
                        saveBtn.disabled = false;
                        if (feedback) { feedback.textContent = "❌ שגיאת תקשורת."; feedback.className = "ms-3 small text-danger"; }
                    });
                });
            }

            // =====================================================================
            // לוגיקת חיפוש והוספת משתמש AD
            // =====================================================================
            const adSearchInput = document.getElementById("ad-search-input");
            const adSearchResults = document.getElementById("ad-search-results");
            const adSearchList = document.getElementById("ad-search-list");
            const adSearchLoading = document.getElementById("ad-search-loading");
            
            const adSelectedForm = document.getElementById("ad-selected-user-form");
            const adSelectedUsername = document.getElementById("ad-selected-username");
            const adSelectedEmail = document.getElementById("ad-selected-email");
            const adSelectedFullName = document.getElementById("ad-selected-fullname");
            const btnSubmitAdUser = document.getElementById("btn-submit-ad-user");
            const addUserFeedback = document.getElementById("add-user-feedback");

            let searchTimeout = null;

            if (adSearchInput) {
                adSearchInput.addEventListener("input", function() {
                    const query = this.value.trim();
                    if (query.length < 2) {
                        adSearchResults.classList.add("d-none");
                        return;
                    }

                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        adSearchResults.classList.remove("d-none");
                        adSearchList.innerHTML = "";
                        adSearchLoading.style.display = "block";

                        fetch(`@Url.Action("SearchAD", "Admin")?query=${encodeURIComponent(query)}`)
                            .then(res => res.json())
                            .then(data => {
                                adSearchLoading.style.display = "none";
                                if (data.success && data.results.length > 0) {
                                    data.results.forEach(u => {
                                        const li = document.createElement("li");
                                        li.className = "p-3 border-bottom border-secondary ad-result-item";
                                        li.style.cursor = "pointer";
                                        li.innerHTML = `
                                            <div class="admin-text-strong fw-bold">${u.displayName}</div>
                                            <div class="admin-text-muted small font-monospace" dir="ltr">${u.email} | ${u.domain}\\${u.samAccountName}</div>
                                        `;
                                        li.addEventListener("click", () => {
                                            adSearchInput.value = u.displayName;
                                            adSearchResults.classList.add("d-none");
                                            
                                            adSelectedUsername.value = `${u.domain}\\${u.samAccountName}`;
                                            adSelectedEmail.value = u.email;
                                            adSelectedFullName.value = u.displayName;
                                            adSelectedForm.classList.remove("d-none");
                                        });
                                        // הוספת אפקט Hover דרך JS
                                        li.addEventListener("mouseenter", () => li.style.background = "rgba(255,255,255,0.05)");
                                        li.addEventListener("mouseleave", () => li.style.background = "transparent");
                                        
                                        adSearchList.appendChild(li);
                                    });
                                } else if (!data.success) {
                                    adSearchList.innerHTML = `<li class="p-3 text-center text-danger small">${data.message}</li>`;
                                } else {
                                    adSearchList.innerHTML = `<li class="p-3 text-center admin-text-muted small">לא נמצאו עובדים מתאימים.</li>`;
                                }
                            })
                            .catch(() => {
                                adSearchLoading.style.display = "none";
                                adSearchList.innerHTML = `<li class="p-3 text-center text-danger small">שגיאת חיבור לשרת ה-AD.</li>`;
                            });
                    }, 500); // Debounce
                });

                // סגירת חלון החיפוש בלחיצה מחוץ אליו
                document.addEventListener("click", (e) => {
                    if (!adSearchInput.contains(e.target) && !adSearchResults.contains(e.target)) {
                        adSearchResults.classList.add("d-none");
                    }
                });
            }

            if (btnSubmitAdUser) {
                btnSubmitAdUser.addEventListener("click", function() {
                    const formData = new FormData();
                    formData.append("username", adSelectedUsername.value);
                    formData.append("email", adSelectedEmail.value);
                    formData.append("fullName", adSelectedFullName.value);
                    const csrfInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (csrfInput) formData.append("__RequestVerificationToken", csrfInput.value);

                    btnSubmitAdUser.disabled = true;
                    addUserFeedback.textContent = "יוצר משתמש...";
                    addUserFeedback.className = "mt-2 text-center small admin-text-muted";

                    fetch('@Url.Action("AddUser", "Admin")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            addUserFeedback.textContent = "✅ המשתמש נוסף ואושר!";
                            addUserFeedback.className = "mt-2 text-center small text-success";
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            btnSubmitAdUser.disabled = false;
                            addUserFeedback.textContent = "❌ " + data.message;
                            addUserFeedback.className = "mt-2 text-center small text-danger";
                        }
                    })
                    .catch(() => {
                        btnSubmitAdUser.disabled = false;
                        addUserFeedback.textContent = "❌ שגיאת תקשורת.";
                        addUserFeedback.className = "mt-2 text-center small text-danger";
                    });
                });
            }

            // =====================================================================
            // לוגיקת הוספת משתמש ידני
            // =====================================================================
            const btnSubmitManualUser = document.getElementById("btn-submit-manual-user");
            if (btnSubmitManualUser) {
                btnSubmitManualUser.addEventListener("click", function() {
                    const mUser = document.getElementById("manual-username").value.trim();
                    const mName = document.getElementById("manual-fullname").value.trim();
                    const mEmail = document.getElementById("manual-email").value.trim();
                    const fb = document.getElementById("add-manual-feedback");

                    if (!mUser) {
                        fb.textContent = "❌ שדה שם משתמש הוא חובה.";
                        fb.className = "mt-2 text-center small text-danger";
                        return;
                    }

                    const formData = new FormData();
                    formData.append("username", mUser);
                    formData.append("fullName", mName);
                    formData.append("email", mEmail);
                    formData.append("authType", "Local");
                    const csrfInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (csrfInput) formData.append("__RequestVerificationToken", csrfInput.value);

                    btnSubmitManualUser.disabled = true;
                    fb.textContent = "יוצר משתמש...";
                    fb.className = "mt-2 text-center small admin-text-muted";

                    fetch('@Url.Action("AddUser", "Admin")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            fb.textContent = "✅ המשתמש נוסף ואושר!";
                            fb.className = "mt-2 text-center small text-success";
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            btnSubmitManualUser.disabled = false;
                            fb.textContent = "❌ " + data.message;
                            fb.className = "mt-2 text-center small text-danger";
                        }
                    })
                    .catch(() => {
                        btnSubmitManualUser.disabled = false;
                        fb.textContent = "❌ שגיאת תקשורת.";
                        fb.className = "mt-2 text-center small text-danger";
                    });
                });
            }
        });
    </script>
}
