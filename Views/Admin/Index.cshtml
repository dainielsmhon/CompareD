                            <label class="settings-label mb-1">שם משתמש למערכת</label>
                            <input type="text" id="manual-username" class="form-control admin-input font-monospace" dir="ltr" placeholder="לדוגמה: DOMAIN\user" />
                            <small class="admin-text-muted">למשתמשי קבלן/חיצוניים. הקפד על שם המחשב או הדומיין המדויק.</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="settings-label mb-1">שם מלא</label>
                            <input type="text" id="manual-fullname" class="form-control admin-input" placeholder="שם העובד" />
