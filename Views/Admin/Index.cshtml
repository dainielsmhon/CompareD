                        <div id="ad-selected-user-form" class="d-none">
                            <div class="mb-3">
                                <label class="settings-label mb-1">שם משתמש בדומיין</label>
                                <input type="text" id="ad-selected-username" class="form-control admin-input font-monospace text-muted" readonly dir="ltr" />
                                <small class="admin-text-muted">פורמט: DOMAIN\user — הזדהות מול הדומיין ללא סיסמה מקומית.</small>
                            </div>
                            
                            <div class="mb-4">
                                <label class="settings-label mb-1">אימייל ארגוני</label>
                                <input type="email" id="ad-selected-email" class="form-control admin-input text-muted" readonly dir="ltr" />
