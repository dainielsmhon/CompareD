<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- הגדרת גרסת ה-Dotnet ל-10.0 כפי שאושר על ידי המשתמש -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- הפעלת תכונות טיפוסים ריקים (Nullable) לבטיחות מירבית בקוד -->
    <Nullable>enable</Nullable>
    <!-- הפעלת ייבוא ספריות משתמע (Implicit Usings) למניעת כתיבה מרובה של using -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ספריית ה-ADO.NET הרשמית של מיקרוסופט להתחברות ל-SQL Server -->
    <!-- גרסה 10.0.11: מתקנת שתי פרצות אבטחה בדרגת high שדווחו בגרסה 10.0.9
         (GHSA-2p3q-h3hg-jcqq, GHSA-8prm-248r-h957) בשכבת האימות מול Active Directory -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MiniExcel" Version="1.44.1" />
    <!-- ספריית ה-ADO.NET הרשמית של אורקל להתחברות ל-Oracle Database -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.6.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\version.txt').Trim())</Version>
  </PropertyGroup>

  <Target Name="IncrementVersion" BeforeTargets="BeforeCompile" Condition="'$(DeployOnBuild)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$v = Get-Content version.txt; $parts = $v.Split('.'); $parts[-1] = [int]$parts[-1] + 1; $nv = $parts -join '.'; Set-Content version.txt $nv; Write-Host $nv&quot;" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="NewVersion" />
    </Exec>
    <PropertyGroup>
      <Version>$(NewVersion)</Version>
      <AssemblyVersion>$(NewVersion)</AssemblyVersion>
      <FileVersion>$(NewVersion)</FileVersion>
    </PropertyGroup>
    <Message Importance="high" Text="Auto-Incremented Publish Version to $(NewVersion)" />
  </Target>

</Project>
